{
  "name": "habitapp-backend",
  "version": "1.0.0",
  "description": "Backend para HabitApp - Sincronización de hábitos y logs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^4.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "firebase-functions-test": "^3.1.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  },
  "private": true
}
